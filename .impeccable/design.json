  "narrative": {
    "northStar": "Motor-service workfolio",
    "overview": "MotorPH is a Windows desktop workspace built in Java 17 Swing with Nimbus. A deep forest navigation rail anchors warm pale work areas and white working surfaces. The application prioritizes readable employee, attendance and payroll records, with an explicit identity, scope and current section.\n\nThe built system uses compact Segoe UI typography, flat native painters, restrained hairlines and line icons. Its character is practical and orderly: tasks share the same shell, controls retain recognizable native behavior, and dense data receives scrollable space. MotorPH and the supplied organization identity remain product truth; this document makes no additional branding or licensing claims.",
    "keyCharacteristics": [
      "Persistent forest navigation with a distinct filled current section.",
      "Warm neutral workspace, white forms and flat controls.",
      "Compact readable type with grouped, adaptive fields.",
      "Semantic actions, explicit prerequisites and recoverable feedback."
    ],
    "rules": [
      {
        "name": "The State Has Meaning Rule",
        "body": "Filled navigation identifies the current section; a focus outline identifies keyboard focus. Preserve both independently.",
        "section": "colors"
      },
      {
        "name": "The Readable Density Rule",
        "body": "Reflow fields and scroll records before reducing shared labels or body type.",
        "section": "typography"
      },
      {
        "name": "The Flat Work Surface Rule",
        "body": "Use neutral fills and hairlines for working controls and containers; do not restore metallic gradients or recessed field treatment to shared surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve MotorPH and the supplied organization identity without invented business claims.",
      "Do reuse the shared native shell, theme and field helpers for new workspace surfaces.",
      "Do keep identity, role scope, current section and keyboard focus distinguishable.",
      "Do reflow form columns and provide horizontal data scrolling before shrinking readable text.",
      "Do explain empty states and enforce permission, selection and record-state prerequisites.",
      "Do keep disabled labels readable and failures actionable with text."
    ],
    "donts": [
      "Don't introduce web-only layout, hover or accessibility assumptions as native runtime guarantees.",
      "Don't add decorative shadows, metallic gradients or recessed treatments to shared work surfaces.",
      "Don't replace complete labels or table data with clipped text to conceal a layout issue.",
      "Don't equate a focus outline with the current navigation selection.",
      "Don't present synthetic capture data or a native self-print as production or physical OS-input proof."
    ]
  }
}
